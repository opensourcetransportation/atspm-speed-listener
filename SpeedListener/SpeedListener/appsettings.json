{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "SpeedListener": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Utah.Udot.Atspm": "Warning"
    }
  },
  "SpeedListenerConfiguration": {
    "UdpPort": 10088,
    "EventTimeZoneId": "UTC",
    "UntaggedSpeedDetectorMappings": {},
    "ChannelCapacity": 100000,
    "BatchSize": 5000,
    "FlushInterval": "00:00:30",
    "ShutdownFlushTimeout": "00:00:45",
    "ShutdownMaxWriteAttempts": 1,
    "DeviceMappingRefreshInterval": "00:05:00",
    "ArchiveParallelism": 50,
    "DatabaseWriteParallelism": 8,
    "WriteTimeout": "00:00:30",
    "MaxWriteAttempts": 3,
    "PoisonDeviceFailureThreshold": 3,
    "SummaryInterval": "00:01:00"
  }
